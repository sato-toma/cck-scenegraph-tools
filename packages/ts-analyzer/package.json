{
    "name": "ts-cck-analyzer",
    "version": "1.0.0",
    "description": "ClusterScript TypeScript analyzer with component constraint validation",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "ts-analyzer": "dist/cli.js"
    },
    "scripts": {
        "build": "tsc",
        "analyze": "node dist/cli.js",
        "scenegraph:analyze": "node ./scripts/export-and-analyze.js",
        "dev": "tsc --watch",
        "test": "vitest run",
        "typecheck:test": "tsc --noEmit -p test/tsconfig.json",
        "verify": "npm run build && npm run typecheck:test && npm run test",
        "update-types": "node ./scripts/update-types.js"
    },
    "keywords": [
        "cluster",
        "clusterscript",
        "typescript",
        "static-analysis",
        "unity-components"
    ],
    "author": "",
    "dependencies": {
        "@iarna/toml": "^2.2.5",
        "@modelcontextprotocol/sdk": "^1.32.2",
        "typescript": "^7.0.2"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "vitest": "^5.0.5"
    }
}
